{
  "name": "ai-generated-tools",
  "version": "1.0.0",
  "private": true,
  "description": "AI 生成的小工具集合：一个目录页 + apps/ 下的各个纯静态小工具",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "deploy": "npx --yes wrangler deploy",
    "deploy:pages": "npx --yes wrangler pages deploy dist --project-name=ai-generated-apps --branch=main --commit-dirty=true"
  },
  "engines": {
    "node": ">=18"
  }
}
